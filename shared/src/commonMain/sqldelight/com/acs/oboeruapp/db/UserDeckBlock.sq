CREATE TABLE user_deck_block (
    id TEXT NOT NULL PRIMARY KEY,
    topic TEXT NOT NULL,
    activity_type TEXT NOT NULL,
    daily_target INTEGER NOT NULL DEFAULT 0,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted_at INTEGER,
    is_synced INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idx_deck_block_active ON user_deck_block(deleted_at, sort_order);

countAllBlocks:
SELECT COUNT(*) FROM user_deck_block;

selectActiveBlocks:
SELECT * FROM user_deck_block
WHERE deleted_at IS NULL
ORDER BY sort_order ASC, created_at ASC;

selectById:
SELECT * FROM user_deck_block WHERE id = :id;

selectActiveByTopicAndActivity:
SELECT * FROM user_deck_block
WHERE topic = :topic
  AND activity_type = :activityType
  AND deleted_at IS NULL
LIMIT 1;

upsert:
INSERT OR REPLACE INTO user_deck_block(
    id,
    topic,
    activity_type,
    daily_target,
    sort_order,
    created_at,
    updated_at,
    deleted_at,
    is_synced
) VALUES (
    :id,
    :topic,
    :activityType,
    :dailyTarget,
    :sortOrder,
    :createdAt,
    :updatedAt,
    :deletedAt,
    :isSynced
);

updateDailyTarget:
UPDATE user_deck_block
SET daily_target = :dailyTarget,
    updated_at = :updatedAt,
    is_synced = 0
WHERE id = :id;

softDelete:
UPDATE user_deck_block
SET deleted_at = :deletedAt,
    updated_at = :updatedAt,
    is_synced = 0
WHERE id = :id;

selectUnsynced:
SELECT * FROM user_deck_block WHERE is_synced = 0;

markSynced:
UPDATE user_deck_block
SET is_synced = 1
WHERE id = :id AND updated_at = :updatedAt;

deleteAll:
DELETE FROM user_deck_block;
