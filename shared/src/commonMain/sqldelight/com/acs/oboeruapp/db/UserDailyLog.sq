CREATE TABLE user_daily_log (
    block_id TEXT NOT NULL,
    log_date TEXT NOT NULL,
    completed_count INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL,
    is_synced INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (block_id, log_date)
);

CREATE INDEX idx_daily_log_date ON user_daily_log(log_date);

selectByDate:
SELECT * FROM user_daily_log WHERE log_date = :logDate;

selectByBlockAndDate:
SELECT * FROM user_daily_log
WHERE block_id = :blockId AND log_date = :logDate;

selectActiveDatesDesc:
SELECT DISTINCT log_date FROM user_daily_log
WHERE completed_count > 0
ORDER BY log_date DESC;

upsert:
INSERT OR REPLACE INTO user_daily_log(
    block_id,
    log_date,
    completed_count,
    updated_at,
    is_synced
) VALUES (
    :blockId,
    :logDate,
    :completedCount,
    :updatedAt,
    :isSynced
);

selectUnsynced:
SELECT * FROM user_daily_log WHERE is_synced = 0;

markSynced:
UPDATE user_daily_log
SET is_synced = 1
WHERE block_id = :blockId
  AND log_date = :logDate
  AND updated_at = :updatedAt;

deleteAll:
DELETE FROM user_daily_log;
